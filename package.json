{
  "name": "hire-me-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:architecture": "node scripts/check-prisma-boundary.mjs",
    "dev": "turbo run dev --parallel",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @hire-me/api prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @hire-me/api prisma:migrate:deploy",
    "prisma:migrate:dev": "pnpm --filter @hire-me/api prisma:migrate:dev",
    "prisma:migrate:reset": "pnpm --filter @hire-me/api prisma:migrate:reset",
    "prisma:seed": "pnpm --filter @hire-me/api prisma:seed",
    "prisma:studio": "pnpm --filter @hire-me/api prisma:studio",
    "prisma:validate": "pnpm --filter @hire-me/api prisma:validate",
    "test": "turbo run test",
    "test:db": "pnpm --filter @hire-me/api test:db",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
