model User {
  id              String     @id @default(uuid()) @db.Uuid
  displayName     String
  email           String
  normalizedEmail String     @unique
  status          UserStatus @default(ACTIVE)
  userType        UserType   @default(INTERNAL)
  locale          String     @default("en")
  lastLoginAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                               UserRole[]
  clientContact                       ClientContact?
  commercialOwnedClients              Client[]                   @relation("ClientCommercialOwner")
  missionRecruiters                   MissionRecruiter[]
  responsibleMissionCandidates        MissionCandidate[]         @relation("MissionCandidateResponsibleRecruiter")
  presentedMissionCandidates          MissionCandidate[]         @relation("MissionCandidatePresenter")
  placementConfirmedMissionCandidates MissionCandidate[]         @relation("MissionCandidatePlacementConfirmer")
  missionCandidateEvents              MissionCandidateEvent[]    @relation("MissionCandidateEventActor")
  createdOffers                       RecruitmentOffer[]         @relation("RecruitmentOfferCreator")
  updatedOffers                       RecruitmentOffer[]         @relation("RecruitmentOfferUpdater")
  createdOfferVersions                RecruitmentOfferVersion[]  @relation("RecruitmentOfferVersionCreator")
  updatedOfferVersions                RecruitmentOfferVersion[]  @relation("RecruitmentOfferVersionUpdater")
  sentOfferVersions                   RecruitmentOfferVersion[]  @relation("RecruitmentOfferVersionSender")
  respondedOfferVersions              RecruitmentOfferVersion[]  @relation("RecruitmentOfferVersionResponder")
  withdrawnOfferVersions              RecruitmentOfferVersion[]  @relation("RecruitmentOfferVersionWithdrawer")
  offerEvents                         OfferEvent[]               @relation("OfferEventActor")
  confirmedPlacements                 MissionPlacement[]         @relation("MissionPlacementConfirmer")
  correctedPlacements                 MissionPlacement[]         @relation("MissionPlacementCorrector")
  placementEvents                     PlacementEvent[]           @relation("PlacementEventActor")
  organizedInterviews                 Interview[]                @relation("InterviewOrganizer")
  interviewParticipants               InterviewParticipant[]     @relation("InterviewParticipantUser")
  interviewEvents                     InterviewEvent[]           @relation("InterviewEventActor")
  candidateEvaluations                CandidateEvaluation[]      @relation("EvaluationAuthor")
  assignedTasks                       Task[]                     @relation("TaskAssignee")
  createdTasks                        Task[]                     @relation("TaskCreator")
  ownedTasks                          Task[]                     @relation("TaskOwner")
  completedTasks                      Task[]                     @relation("TaskCompleter")
  canceledTasks                       Task[]                     @relation("TaskCanceler")
  reopenedTasks                       Task[]                     @relation("TaskReopener")
  archivedTasks                       Task[]                     @relation("TaskArchiver")
  taskAssignments                     TaskAssignment[]           @relation("TaskAssignmentUser")
  createdTaskAssignments              TaskAssignment[]           @relation("TaskAssignmentCreator")
  removedTaskAssignments              TaskAssignment[]           @relation("TaskAssignmentRemover")
  authoredTaskComments                TaskComment[]              @relation("TaskCommentAuthor")
  editedTaskComments                  TaskComment[]              @relation("TaskCommentEditor")
  archivedTaskComments                TaskComment[]              @relation("TaskCommentArchiver")
  receivedTaskMentions                TaskMention[]              @relation("TaskMentionUser")
  createdTaskMentions                 TaskMention[]              @relation("TaskMentionCreator")
  receivedTaskReminders               TaskReminder[]             @relation("TaskReminderRecipient")
  createdTaskReminders                TaskReminder[]             @relation("TaskReminderCreator")
  canceledTaskReminders               TaskReminder[]             @relation("TaskReminderCanceler")
  taskEvents                          TaskEvent[]                @relation("TaskEventActor")
  ownedDocuments                      Document[]                 @relation("DocumentOwner")
  createdDocuments                    Document[]                 @relation("DocumentCreator")
  createdDocumentVersions             DocumentVersion[]          @relation("DocumentVersionCreator")
  uploadedCandidateDocuments          CandidateDocument[]        @relation("CandidateDocumentUploader")
  createdCandidateDocumentVersions    CandidateDocumentVersion[] @relation("CandidateDocumentVersionCreator")
  notifications                       Notification[]             @relation("NotificationRecipient")
  authoredNotifications               Notification[]             @relation("NotificationActor")
  archivedNotifications               Notification[]             @relation("NotificationArchiver")
  authoredMessages                    Message[]                  @relation("MessageAuthor")
  conversationMemberships             ConversationMember[]
  trainingEnrollments                 TrainingEnrollment[]       @relation("UserTrainingEnrollment")
  trainingProgramsOwned               TrainingProgram[]          @relation("TrainingProgramOwner")
  trainingSessionsTrained             TrainingSession[]          @relation("TrainingSessionTrainer")
  auditLogs                           AuditLog[]                 @relation("AuditActor")
  targetedAuditLogs                   AuditLog[]                 @relation("AuditTargetUser")
  passwordCredential                  PasswordCredential?
  refreshSessions                     RefreshSession[]

  @@index([status])
  @@index([userType])
}

model PasswordCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  passwordHash      String
  algorithm         String   @default("argon2id")
  parametersVersion String   @default("argon2id-v1")
  passwordUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parametersVersion])
}

model RefreshSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tokenHash            String    @unique
  sessionFamilyId      String    @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  expiresAt            DateTime
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  reuseDetectedAt      DateTime?
  rotatedFromSessionId String?   @db.Uuid
  userAgentHash        String?
  ipAddressHash        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([sessionFamilyId])
  @@index([rotatedFromSessionId])
  @@index([expiresAt])
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String
  status      RoleStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String              @id @default(uuid()) @db.Uuid
  code        String              @unique
  description String
  scopeType   PermissionScopeType
  status      PermissionStatus    @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  roles RolePermission[]

  @@index([scopeType])
  @@index([status])
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  roleId     String    @db.Uuid
  assignedAt DateTime  @default(now())
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  grantedAt    DateTime  @default(now())
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Client {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  normalizedName        String
  status                ClientStatus @default(PROSPECT)
  industry              String?
  website               String?
  mainPhone             String?
  country               String?
  city                  String?
  commercialOwnerUserId String?      @db.Uuid
  commercialSummary     String?
  archivedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  commercialOwner User?                @relation("ClientCommercialOwner", fields: [commercialOwnerUserId], references: [id], onDelete: SetNull)
  contacts        ClientContact[]
  missions        RecruitmentMission[]
  documents       Document[]
  tasks           Task[]

  @@index([normalizedName])
  @@index([status])
  @@index([industry])
  @@index([country])
  @@index([city])
  @@index([commercialOwnerUserId])
}

model ClientContact {
  id              String              @id @default(uuid()) @db.Uuid
  clientId        String              @db.Uuid
  userId          String?             @unique @db.Uuid
  displayName     String
  email           String
  normalizedEmail String
  phone           String?
  roleTitle       String?
  status          ClientContactStatus @default(ACTIVE)
  portalStatus    PortalAccessStatus  @default(DISABLED)
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  interviewParticipants InterviewParticipant[] @relation("InterviewParticipantClientContact")
  trainingEnrollments   TrainingEnrollment[]   @relation("ClientContactTrainingEnrollment")
  tasks                 Task[]

  @@unique([clientId, normalizedEmail])
  @@index([clientId])
  @@index([portalStatus])
}

model Candidate {
  id                        String          @id @default(uuid()) @db.Uuid
  displayName               String
  firstName                 String?
  lastName                  String?
  email                     String?
  normalizedEmail           String?
  phone                     String?
  normalizedPhone           String?
  city                      String?
  country                   String?
  currentJobTitle           String?
  professionalSummary       String?
  linkedinUrl               String?
  status                    CandidateStatus @default(ACTIVE)
  source                    String?
  sourceDetail              String?
  consentStatus             ConsentStatus   @default(UNKNOWN)
  consentRecordedAt         DateTime?
  availabilityNotice        String?
  salaryExpectationCents    Int?
  salaryExpectationCurrency String?
  archivedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  documents              CandidateDocument[]
  skills                 CandidateSkill[]
  languages              CandidateLanguage[]
  workExperiences        CandidateWorkExperience[]
  education              CandidateEducation[]
  missionCandidates      MissionCandidate[]
  documentsReferenced    Document[]
  publicApplications     PublicCandidateApplication[]
  publicApplicationFiles PublicCandidateApplicationFile[]
  trainingEnrollments    TrainingEnrollment[]             @relation("CandidateTrainingEnrollment")
  tasks                  Task[]

  @@unique([normalizedEmail])
  @@index([status])
  @@index([source])
  @@index([city])
  @@index([country])
  @@index([currentJobTitle])
  @@index([linkedinUrl])
}

model CandidateSkill {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @db.Uuid
  name        String
  level       String?
  years       Int?
  lastUsed    String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@index([name])
}

model CandidateLanguage {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @db.Uuid
  language    String
  proficiency String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@index([language])
}

model CandidateWorkExperience {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @db.Uuid
  employer    String
  title       String
  startDate   String?
  endDate     String?
  isCurrent   Boolean   @default(false)
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@index([employer])
  @@index([title])
}

model CandidateEducation {
  id            String    @id @default(uuid()) @db.Uuid
  candidateId   String    @db.Uuid
  institution   String
  qualification String
  field         String?
  startDate     String?
  endDate       String?
  description   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)

  @@index([candidateId])
  @@index([institution])
  @@index([qualification])
}

model CandidateDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  candidateId      String                  @db.Uuid
  documentType     CandidateDocumentType
  title            String
  currentVersionId String?                 @unique @db.Uuid
  visibility       DocumentVisibility      @default(INTERNAL_ONLY)
  uploadedByUserId String?                 @db.Uuid
  status           CandidateDocumentStatus @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  candidate      Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  uploadedBy     User?                      @relation("CandidateDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  versions       CandidateDocumentVersion[] @relation("CandidateDocumentVersions")
  currentVersion CandidateDocumentVersion?  @relation("CurrentCandidateDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([candidateId])
  @@index([visibility])
  @@index([status])
}

model CandidateDocumentVersion {
  id                  String                  @id @default(uuid()) @db.Uuid
  candidateDocumentId String                  @db.Uuid
  versionNumber       Int
  filename            String
  storageKey          String                  @unique
  mimeType            String
  sizeBytes           BigInt
  createdByUserId     String?                 @db.Uuid
  source              DocumentVersionSource
  status              CandidateDocumentStatus @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  candidateDocument      CandidateDocument                @relation("CandidateDocumentVersions", fields: [candidateDocumentId], references: [id], onDelete: Restrict)
  currentFor             CandidateDocument?               @relation("CurrentCandidateDocumentVersion")
  createdBy              User?                            @relation("CandidateDocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publicApplicationFiles PublicCandidateApplicationFile[]

  @@unique([candidateDocumentId, versionNumber])
  @@index([candidateDocumentId])
  @@index([createdByUserId])
}

model PublicOpportunity {
  id                           String                  @id @default(uuid()) @db.Uuid
  missionId                    String                  @unique @db.Uuid
  status                       PublicOpportunityStatus @default(DRAFT)
  applicationLinkEnabled       Boolean                 @default(false)
  listedOnWebsite              Boolean                 @default(false)
  publicSlug                   String                  @unique
  publicationStartsAt          DateTime?
  applicationDeadline          DateTime?
  publicTitle                  String
  publicSummary                String?
  publicDescription            String?
  publicLocation               String?
  publicWorkArrangement        String?
  publicEngagementType         String?
  publicExperienceLevel        String?
  publicSkills                 String?
  showClientName               Boolean                 @default(false)
  showSalary                   Boolean                 @default(false)
  cvRequired                   Boolean                 @default(true)
  certificationsEnabled        Boolean                 @default(true)
  certificationsRequired       Boolean                 @default(false)
  diplomasEnabled              Boolean                 @default(true)
  diplomasRequired             Boolean                 @default(false)
  additionalAttachmentsEnabled Boolean                 @default(false)
  consentTextVersion           String                  @default("public-application-consent-v1")
  archivedAt                   DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  mission      RecruitmentMission               @relation(fields: [missionId], references: [id], onDelete: Restrict)
  applications PublicCandidateApplication[]
  files        PublicCandidateApplicationFile[]

  @@index([status])
  @@index([applicationLinkEnabled])
  @@index([listedOnWebsite])
  @@index([publicationStartsAt])
  @@index([applicationDeadline])
  @@index([archivedAt])
}

model PublicCandidateApplication {
  id                                 String                  @id @default(uuid()) @db.Uuid
  publicOpportunityId                String                  @db.Uuid
  missionId                          String                  @db.Uuid
  candidateId                        String                  @db.Uuid
  missionCandidateId                 String                  @unique @db.Uuid
  status                             PublicApplicationStatus @default(SUBMITTED)
  submittedFullName                  String
  submittedEmail                     String
  submittedNormalizedEmail           String
  submittedPhone                     String?
  submittedNormalizedPhone           String?
  submittedCity                      String?
  submittedCountry                   String?
  submittedCurrentPosition           String?
  submittedExperienceYears           Int?
  submittedSkills                    String?
  submittedLanguages                 String?
  submittedAvailability              String?
  submittedSalaryExpectationCents    Int?
  submittedSalaryExpectationCurrency String?
  submittedProfessionalLinks         String?
  submittedMotivation                String?
  consentGranted                     Boolean
  consentTextVersion                 String
  submittedAt                        DateTime                @default(now())
  sourceIpHash                       String?
  userAgentHash                      String?
  archivedAt                         DateTime?
  createdAt                          DateTime                @default(now())
  updatedAt                          DateTime                @updatedAt

  publicOpportunity PublicOpportunity                @relation(fields: [publicOpportunityId], references: [id], onDelete: Restrict)
  mission           RecruitmentMission               @relation(fields: [missionId], references: [id], onDelete: Restrict)
  candidate         Candidate                        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  missionCandidate  MissionCandidate                 @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  files             PublicCandidateApplicationFile[]

  @@unique([publicOpportunityId, submittedNormalizedEmail])
  @@index([missionId])
  @@index([candidateId])
  @@index([status])
  @@index([submittedAt])
}

model PublicCandidateApplicationFile {
  id                           String                        @id @default(uuid()) @db.Uuid
  publicCandidateApplicationId String                        @db.Uuid
  publicOpportunityId          String                        @db.Uuid
  missionId                    String                        @db.Uuid
  missionCandidateId           String                        @db.Uuid
  candidateId                  String                        @db.Uuid
  candidateDocumentVersionId   String                        @unique @db.Uuid
  category                     PublicApplicationFileCategory
  originalFilename             String
  sanitizedFilename            String
  mimeType                     String
  sizeBytes                    BigInt
  storageKey                   String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  application              PublicCandidateApplication @relation(fields: [publicCandidateApplicationId], references: [id], onDelete: Restrict)
  publicOpportunity        PublicOpportunity          @relation(fields: [publicOpportunityId], references: [id], onDelete: Restrict)
  mission                  RecruitmentMission         @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionCandidate         MissionCandidate           @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  candidate                Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  candidateDocumentVersion CandidateDocumentVersion   @relation(fields: [candidateDocumentVersionId], references: [id], onDelete: Restrict)

  @@index([publicCandidateApplicationId])
  @@index([publicOpportunityId])
  @@index([missionId])
  @@index([missionCandidateId])
  @@index([candidateId])
  @@index([category])
  @@index([createdAt])
}

model RecruitmentMission {
  id                   String                  @id @default(uuid()) @db.Uuid
  clientId             String                  @db.Uuid
  title                String
  description          String?
  requirements         String?
  state                RecruitmentMissionState @default(DRAFT)
  priority             TaskPriority            @default(NORMAL)
  numberOfPositions    Int                     @default(1)
  filledPlacementCount Int                     @default(0)
  location             String?
  workArrangement      String?
  engagementType       String?
  targetStartDate      DateTime?
  applicationDeadline  DateTime?
  salaryMinCents       Int?
  salaryMaxCents       Int?
  salaryCurrency       String?
  closureReason        MissionClosureReason?
  closedAt             DateTime?
  commercialSummary    String?
  archivedAt           DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  client                 Client                           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recruiters             MissionRecruiter[]
  missionCandidates      MissionCandidate[]
  offers                 RecruitmentOffer[]
  offerVersions          RecruitmentOfferVersion[]
  placements             MissionPlacement[]
  publicOpportunity      PublicOpportunity?
  publicApplications     PublicCandidateApplication[]
  publicApplicationFiles PublicCandidateApplicationFile[]
  documents              Document[]
  tasks                  Task[]
  notifications          Notification[]

  @@index([clientId])
  @@index([state])
  @@index([priority])
  @@index([applicationDeadline])
  @@index([closureReason])
}

model MissionRecruiter {
  id         String               @id @default(uuid()) @db.Uuid
  missionId  String               @db.Uuid
  userId     String               @db.Uuid
  role       MissionRecruiterRole @default(RECRUITER)
  assignedAt DateTime             @default(now())
  status     AssignmentStatus     @default(ACTIVE)
  isLead     Boolean              @default(false)
  endedAt    DateTime?
  archivedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  mission RecruitmentMission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  user    User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  tasks   Task[]

  @@index([missionId])
  @@index([userId])
  @@index([status])
}

model MissionCandidate {
  id                         String                @id @default(uuid()) @db.Uuid
  missionId                  String                @db.Uuid
  candidateId                String                @db.Uuid
  responsibleRecruiterUserId String                @db.Uuid
  state                      MissionCandidateState @default(NEW)
  rank                       Int?
  source                     String?
  sourceContext              String?
  priority                   TaskPriority          @default(NORMAL)
  internalNotes              String?
  outcomeReason              String?
  clientVisible              Boolean               @default(false)
  presentedAt                DateTime?
  presentedByUserId          String?               @db.Uuid
  placementConfirmedAt       DateTime?
  placementConfirmedByUserId String?               @db.Uuid
  archivedAt                 DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  mission                RecruitmentMission               @relation(fields: [missionId], references: [id], onDelete: Restrict)
  candidate              Candidate                        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  responsibleRecruiter   User                             @relation("MissionCandidateResponsibleRecruiter", fields: [responsibleRecruiterUserId], references: [id], onDelete: Restrict)
  presentedBy            User?                            @relation("MissionCandidatePresenter", fields: [presentedByUserId], references: [id], onDelete: SetNull)
  placementConfirmedBy   User?                            @relation("MissionCandidatePlacementConfirmer", fields: [placementConfirmedByUserId], references: [id], onDelete: SetNull)
  offers                 RecruitmentOffer[]
  offerVersions          RecruitmentOfferVersion[]
  placement              MissionPlacement?
  events                 MissionCandidateEvent[]
  interviews             Interview[]
  evaluations            CandidateEvaluation[]
  publicApplication      PublicCandidateApplication?
  publicApplicationFiles PublicCandidateApplicationFile[]
  documents              Document[]
  tasks                  Task[]
  notifications          Notification[]

  @@unique([missionId, candidateId])
  @@index([candidateId])
  @@index([missionId])
  @@index([responsibleRecruiterUserId])
  @@index([state])
  @@index([clientVisible])
  @@index([presentedAt])
}

model RecruitmentOffer {
  id                 String    @id @default(uuid()) @db.Uuid
  missionId          String    @db.Uuid
  missionCandidateId String    @db.Uuid
  createdByUserId    String?   @db.Uuid
  updatedByUserId    String?   @db.Uuid
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  mission          RecruitmentMission        @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionCandidate MissionCandidate          @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  createdBy        User?                     @relation("RecruitmentOfferCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?                     @relation("RecruitmentOfferUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  versions         RecruitmentOfferVersion[]
  events           OfferEvent[]
  tasks            Task[]

  @@unique([missionCandidateId])
  @@index([missionId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedAt])
}

model RecruitmentOfferVersion {
  id                       String      @id @default(uuid()) @db.Uuid
  offerId                  String      @db.Uuid
  missionId                String      @db.Uuid
  missionCandidateId       String      @db.Uuid
  versionNumber            Int
  status                   OfferStatus @default(DRAFT)
  isCurrent                Boolean     @default(true)
  offeredSalaryAmountCents Int?
  offeredSalaryCurrency    String?
  contractType             String?
  proposedStartDate        DateTime?
  probationPeriod          String?
  bonuses                  String?
  benefits                 String?
  allowances               String?
  compensationNotes        String?
  clientFacingRemarks      String?
  internalRecruiterRemarks String?
  createdByUserId          String?     @db.Uuid
  updatedByUserId          String?     @db.Uuid
  sentByUserId             String?     @db.Uuid
  sentAt                   DateTime?
  responseRecordedByUserId String?     @db.Uuid
  responseRecordedAt       DateTime?
  responseReason           String?
  withdrawnByUserId        String?     @db.Uuid
  withdrawnAt              DateTime?
  withdrawalReason         String?
  expiresAt                DateTime?
  expiredAt                DateTime?
  archivedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  offer              RecruitmentOffer   @relation(fields: [offerId], references: [id], onDelete: Restrict)
  mission            RecruitmentMission @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionCandidate   MissionCandidate   @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  createdBy          User?              @relation("RecruitmentOfferVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy          User?              @relation("RecruitmentOfferVersionUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  sentBy             User?              @relation("RecruitmentOfferVersionSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  responseRecordedBy User?              @relation("RecruitmentOfferVersionResponder", fields: [responseRecordedByUserId], references: [id], onDelete: SetNull)
  withdrawnBy        User?              @relation("RecruitmentOfferVersionWithdrawer", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)
  placement          MissionPlacement?
  events             OfferEvent[]
  tasks              Task[]

  @@unique([offerId, versionNumber])
  @@index([offerId])
  @@index([missionId])
  @@index([missionCandidateId])
  @@index([status])
  @@index([isCurrent])
  @@index([createdByUserId])
  @@index([sentByUserId])
  @@index([responseRecordedByUserId])
  @@index([archivedAt])
}

model OfferEvent {
  id                String           @id @default(uuid()) @db.Uuid
  offerId           String           @db.Uuid
  offerVersionId    String?          @db.Uuid
  actorUserId       String?          @db.Uuid
  action            OfferEventAction
  previousStatus    OfferStatus?
  nextStatus        OfferStatus?
  previousVersionId String?          @db.Uuid
  nextVersionId     String?          @db.Uuid
  reason            String?
  safeComment       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  offer        RecruitmentOffer         @relation(fields: [offerId], references: [id], onDelete: Restrict)
  offerVersion RecruitmentOfferVersion? @relation(fields: [offerVersionId], references: [id], onDelete: SetNull)
  actor        User?                    @relation("OfferEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([offerVersionId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model MissionPlacement {
  id                            String                     @id @default(uuid()) @db.Uuid
  missionId                     String                     @db.Uuid
  missionCandidateId            String                     @unique @db.Uuid
  offerVersionId                String                     @unique @db.Uuid
  status                        PlacementStatus            @default(CONFIRMED)
  integrationStartDate          DateTime
  confirmedByUserId             String?                    @db.Uuid
  confirmedAt                   DateTime                   @default(now())
  operationalNote               String?
  eligibleForInvoicing          Boolean                    @default(false)
  invoicingEligibleAt           DateTime?
  commercialEligibilityByUserId String?                    @db.Uuid
  correctedAt                   DateTime?
  correctedByUserId             String?                    @db.Uuid
  correctionReason              PlacementCorrectionReason?
  correctionComment             String?
  archivedAt                    DateTime?
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt

  mission          RecruitmentMission      @relation(fields: [missionId], references: [id], onDelete: Restrict)
  missionCandidate MissionCandidate        @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  offerVersion     RecruitmentOfferVersion @relation(fields: [offerVersionId], references: [id], onDelete: Restrict)
  confirmedBy      User?                   @relation("MissionPlacementConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  correctedBy      User?                   @relation("MissionPlacementCorrector", fields: [correctedByUserId], references: [id], onDelete: SetNull)
  events           PlacementEvent[]
  tasks            Task[]

  @@index([missionId])
  @@index([status])
  @@index([confirmedByUserId])
  @@index([correctedByUserId])
  @@index([eligibleForInvoicing])
  @@index([archivedAt])
}

model PlacementEvent {
  id             String               @id @default(uuid()) @db.Uuid
  placementId    String               @db.Uuid
  actorUserId    String?              @db.Uuid
  action         PlacementEventAction
  previousStatus PlacementStatus?
  nextStatus     PlacementStatus?
  reason         String?
  safeComment    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  placement MissionPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  actor     User?            @relation("PlacementEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([placementId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model MissionCandidateEvent {
  id                  String                      @id @default(uuid()) @db.Uuid
  missionCandidateId  String                      @db.Uuid
  actorUserId         String?                     @db.Uuid
  action              MissionCandidateEventAction
  previousState       MissionCandidateState?
  nextState           MissionCandidateState?
  previousRecruiterId String?                     @db.Uuid
  nextRecruiterId     String?                     @db.Uuid
  reason              String?
  safeComment         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  missionCandidate MissionCandidate @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  actor            User?            @relation("MissionCandidateEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([missionCandidateId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Interview {
  id                 String          @id @default(uuid()) @db.Uuid
  missionCandidateId String          @db.Uuid
  type               InterviewType
  scheduledStartAt   DateTime
  scheduledEndAt     DateTime?
  timezone           String
  format             InterviewFormat
  location           String?
  meetingUrl         String?
  organizerUserId    String          @db.Uuid
  status             InterviewStatus @default(SCHEDULED)
  outcome            String?
  completedAt        DateTime?
  canceledAt         DateTime?
  postponedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  missionCandidate MissionCandidate       @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  organizer        User                   @relation("InterviewOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  participants     InterviewParticipant[]
  events           InterviewEvent[]
  evaluations      CandidateEvaluation[]
  documents        Document[]
  tasks            Task[]
  notifications    Notification[]

  @@index([missionCandidateId])
  @@index([organizerUserId])
  @@index([scheduledStartAt])
  @@index([status])
  @@index([type])
}

model InterviewParticipant {
  id              String                     @id @default(uuid()) @db.Uuid
  interviewId     String                     @db.Uuid
  kind            InterviewParticipantKind
  userId          String?                    @db.Uuid
  clientContactId String?                    @db.Uuid
  externalName    String?
  externalRole    String?
  status          InterviewParticipantStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  interview     Interview      @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  user          User?          @relation("InterviewParticipantUser", fields: [userId], references: [id], onDelete: Restrict)
  clientContact ClientContact? @relation("InterviewParticipantClientContact", fields: [clientContactId], references: [id], onDelete: Restrict)

  @@index([interviewId])
  @@index([userId])
  @@index([clientContactId])
  @@index([status])
}

model InterviewEvent {
  id               String               @id @default(uuid()) @db.Uuid
  interviewId      String               @db.Uuid
  actorUserId      String?              @db.Uuid
  action           InterviewEventAction
  previousStatus   InterviewStatus?
  nextStatus       InterviewStatus?
  previousStartAt  DateTime?
  nextStartAt      DateTime?
  previousEndAt    DateTime?
  nextEndAt        DateTime?
  previousTimezone String?
  nextTimezone     String?
  participantId    String?              @db.Uuid
  reason           String?
  safeComment      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  actor     User?     @relation("InterviewEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([interviewId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model CandidateEvaluation {
  id                   String                    @id @default(uuid()) @db.Uuid
  missionCandidateId   String                    @db.Uuid
  interviewId          String                    @db.Uuid
  authorUserId         String                    @db.Uuid
  evaluationType       EvaluationType
  recommendation       EvaluationRecommendation?
  recommended          Boolean?
  overallScore         Int?
  communicationScore   Int?
  technicalScore       Int?
  roleFitScore         Int?
  cultureFitScore      Int?
  motivationScore      Int?
  salaryAlignmentScore Int?
  strengths            String?
  weaknesses           String?
  risks                String?
  comment              String?
  finalOpinion         Boolean                   @default(false)
  internalOnly         Boolean                   @default(true)
  clientVisible        Boolean                   @default(false)
  status               EvaluationStatus          @default(DRAFT)
  submittedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  missionCandidate MissionCandidate @relation(fields: [missionCandidateId], references: [id], onDelete: Restrict)
  interview        Interview        @relation(fields: [interviewId], references: [id], onDelete: Restrict)
  author           User             @relation("EvaluationAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([missionCandidateId])
  @@index([interviewId])
  @@index([authorUserId])
  @@index([evaluationType])
  @@index([status])
}

model Task {
  id                             String       @id @default(uuid()) @db.Uuid
  title                          String
  description                    String?
  status                         TaskStatus   @default(OPEN)
  startAt                        DateTime?
  dueAt                          DateTime?
  timezone                       String?
  priority                       TaskPriority @default(NORMAL)
  ownerUserId                    String?      @db.Uuid
  assigneeUserId                 String?      @db.Uuid
  createdByUserId                String?      @db.Uuid
  completedByUserId              String?      @db.Uuid
  canceledByUserId               String?      @db.Uuid
  reopenedByUserId               String?      @db.Uuid
  archivedByUserId               String?      @db.Uuid
  candidateId                    String?      @db.Uuid
  clientId                       String?      @db.Uuid
  clientContactId                String?      @db.Uuid
  recruitmentMissionId           String?      @db.Uuid
  missionRecruiterId             String?      @db.Uuid
  missionCandidateId             String?      @db.Uuid
  interviewId                    String?      @db.Uuid
  recruitmentOfferId             String?      @db.Uuid
  recruitmentOfferVersionId      String?      @db.Uuid
  missionPlacementId             String?      @db.Uuid
  trainingProgramId              String?      @db.Uuid
  trainingSessionId              String?      @db.Uuid
  trainingEnrollmentId           String?      @db.Uuid
  trainingSessionParticipationId String?      @db.Uuid
  documentId                     String?      @db.Uuid
  completedAt                    DateTime?
  completionNote                 String?
  canceledAt                     DateTime?
  cancellationReason             String?
  reopenedAt                     DateTime?
  reopenReason                   String?
  blockingReason                 String?
  archivedAt                     DateTime?
  archiveReason                  String?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt

  assignee                     User?                         @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy                    User?                         @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  owner                        User?                         @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  completedBy                  User?                         @relation("TaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  canceledBy                   User?                         @relation("TaskCanceler", fields: [canceledByUserId], references: [id], onDelete: SetNull)
  reopenedBy                   User?                         @relation("TaskReopener", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  archivedBy                   User?                         @relation("TaskArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  candidate                    Candidate?                    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  client                       Client?                       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientContact                ClientContact?                @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  recruitmentMission           RecruitmentMission?           @relation(fields: [recruitmentMissionId], references: [id], onDelete: SetNull)
  missionRecruiter             MissionRecruiter?             @relation(fields: [missionRecruiterId], references: [id], onDelete: SetNull)
  missionCandidate             MissionCandidate?             @relation(fields: [missionCandidateId], references: [id], onDelete: SetNull)
  interview                    Interview?                    @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  recruitmentOffer             RecruitmentOffer?             @relation(fields: [recruitmentOfferId], references: [id], onDelete: SetNull)
  recruitmentOfferVersion      RecruitmentOfferVersion?      @relation(fields: [recruitmentOfferVersionId], references: [id], onDelete: SetNull)
  missionPlacement             MissionPlacement?             @relation(fields: [missionPlacementId], references: [id], onDelete: SetNull)
  trainingProgram              TrainingProgram?              @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  trainingSession              TrainingSession?              @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  trainingEnrollment           TrainingEnrollment?           @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  trainingSessionParticipation TrainingSessionParticipation? @relation(fields: [trainingSessionParticipationId], references: [id], onDelete: SetNull)
  document                     Document?                     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assignments                  TaskAssignment[]
  comments                     TaskComment[]
  mentions                     TaskMention[]
  reminders                    TaskReminder[]
  events                       TaskEvent[]
  notifications                Notification[]

  @@index([ownerUserId])
  @@index([assigneeUserId])
  @@index([createdByUserId])
  @@index([status])
  @@index([priority])
  @@index([startAt])
  @@index([dueAt])
  @@index([candidateId])
  @@index([clientId])
  @@index([clientContactId])
  @@index([recruitmentMissionId])
  @@index([missionRecruiterId])
  @@index([missionCandidateId])
  @@index([interviewId])
  @@index([recruitmentOfferId])
  @@index([recruitmentOfferVersionId])
  @@index([missionPlacementId])
  @@index([trainingEnrollmentId])
  @@index([documentId])
  @@index([archivedAt])
}

model TaskAssignment {
  id               String               @id @default(uuid()) @db.Uuid
  taskId           String               @db.Uuid
  userId           String               @db.Uuid
  assignedByUserId String?              @db.Uuid
  removedByUserId  String?              @db.Uuid
  status           TaskAssignmentStatus @default(ACTIVE)
  reason           String?
  assignedAt       DateTime             @default(now())
  removedAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user       User  @relation("TaskAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("TaskAssignmentCreator", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  removedBy  User? @relation("TaskAssignmentRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([userId])
  @@index([assignedByUserId])
  @@index([status])
}

model TaskComment {
  id               String            @id @default(uuid()) @db.Uuid
  taskId           String            @db.Uuid
  authorUserId     String            @db.Uuid
  body             String
  status           TaskCommentStatus @default(ACTIVE)
  editedAt         DateTime?
  editedByUserId   String?           @db.Uuid
  archivedAt       DateTime?
  archivedByUserId String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  task       Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author     User          @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  editedBy   User?         @relation("TaskCommentEditor", fields: [editedByUserId], references: [id], onDelete: SetNull)
  archivedBy User?         @relation("TaskCommentArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  mentions   TaskMention[]

  @@index([taskId])
  @@index([authorUserId])
  @@index([status])
  @@index([createdAt])
}

model TaskMention {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @db.Uuid
  commentId       String   @db.Uuid
  mentionedUserId String   @db.Uuid
  createdByUserId String?  @db.Uuid
  notificationId  String?  @unique @db.Uuid
  createdAt       DateTime @default(now())

  task          Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)
  comment       TaskComment   @relation(fields: [commentId], references: [id], onDelete: Restrict)
  mentionedUser User          @relation("TaskMentionUser", fields: [mentionedUserId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("TaskMentionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  notification  Notification? @relation("TaskMentionNotification", fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([commentId, mentionedUserId])
  @@index([taskId])
  @@index([mentionedUserId])
}

model TaskReminder {
  id              String             @id @default(uuid()) @db.Uuid
  taskId          String             @db.Uuid
  recipientUserId String             @db.Uuid
  creatorUserId   String?            @db.Uuid
  remindAt        DateTime
  status          TaskReminderStatus @default(PENDING)
  idempotencyKey  String
  processingToken String?
  claimedAt       DateTime?
  deliveredAt     DateTime?
  canceledAt      DateTime?
  canceledByUserId String?           @db.Uuid
  failureReason   String?
  attemptCount    Int                @default(0)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  recipient  User  @relation("TaskReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  creator    User? @relation("TaskReminderCreator", fields: [creatorUserId], references: [id], onDelete: SetNull)
  canceledBy User? @relation("TaskReminderCanceler", fields: [canceledByUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([recipientUserId])
  @@index([status, remindAt])
  @@index([createdAt])
  @@unique([taskId, recipientUserId, idempotencyKey])
}

model TaskEvent {
  id             String           @id @default(uuid()) @db.Uuid
  taskId         String           @db.Uuid
  actorUserId    String?          @db.Uuid
  action         TaskEventAction
  previousStatus TaskStatus?
  nextStatus     TaskStatus?
  reason         String?
  safeSummary    String?
  previousOwnerUserId String?          @db.Uuid
  nextOwnerUserId     String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor User? @relation("TaskEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorUserId])
  @@index([previousOwnerUserId])
  @@index([nextOwnerUserId])
  @@index([action])
  @@index([createdAt])
}

model TrainingProgram {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  targetAudience String?
  status         TrainingProgramStatus @default(PROGRAM_DRAFT)
  ownerUserId    String?               @db.Uuid
  archivedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  owner       User?                @relation("TrainingProgramOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sessions    TrainingSession[]
  enrollments TrainingEnrollment[]
  tasks       Task[]

  @@index([status])
  @@index([ownerUserId])
}

model TrainingSession {
  id                String                @id @default(uuid()) @db.Uuid
  trainingProgramId String                @db.Uuid
  trainerUserId     String?               @db.Uuid
  scheduledAt       DateTime
  status            TrainingSessionStatus @default(SESSION_PLANNED)
  location          String?
  meetingUrl        String?
  outcome           String?
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  program        TrainingProgram                @relation(fields: [trainingProgramId], references: [id], onDelete: Restrict)
  trainer        User?                          @relation("TrainingSessionTrainer", fields: [trainerUserId], references: [id], onDelete: SetNull)
  participations TrainingSessionParticipation[]
  documents      Document[]
  tasks          Task[]
  notifications  Notification[]

  @@index([trainingProgramId])
  @@index([trainerUserId])
  @@index([scheduledAt])
  @@index([status])
}

model TrainingEnrollment {
  id                            String                   @id @default(uuid()) @db.Uuid
  trainingProgramId             String                   @db.Uuid
  participantType               TrainingParticipantType
  candidateId                   String?                  @db.Uuid
  userId                        String?                  @db.Uuid
  clientContactId               String?                  @db.Uuid
  externalTrainingParticipantId String?                  @db.Uuid
  status                        TrainingEnrollmentStatus @default(REGISTERED)
  paymentStatus                 PaymentStatus            @default(NOT_REQUIRED)
  evaluationResult              String?
  certificateStatus             CertificateStatus        @default(NOT_APPLICABLE)
  satisfactionScore             Int?
  coachingStatus                String?
  followUpStatus                String?
  archivedAt                    DateTime?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt

  program                     TrainingProgram                @relation(fields: [trainingProgramId], references: [id], onDelete: Restrict)
  candidate                   Candidate?                     @relation("CandidateTrainingEnrollment", fields: [candidateId], references: [id], onDelete: SetNull)
  user                        User?                          @relation("UserTrainingEnrollment", fields: [userId], references: [id], onDelete: SetNull)
  clientContact               ClientContact?                 @relation("ClientContactTrainingEnrollment", fields: [clientContactId], references: [id], onDelete: SetNull)
  externalTrainingParticipant ExternalTrainingParticipant?   @relation(fields: [externalTrainingParticipantId], references: [id], onDelete: SetNull)
  participations              TrainingSessionParticipation[]
  documents                   Document[]
  tasks                       Task[]
  notifications               Notification[]

  @@index([trainingProgramId])
  @@index([participantType])
  @@index([candidateId])
  @@index([userId])
  @@index([clientContactId])
  @@index([externalTrainingParticipantId])
  @@index([status])
}

model TrainingSessionParticipation {
  id                   String                             @id @default(uuid()) @db.Uuid
  trainingSessionId    String                             @db.Uuid
  trainingEnrollmentId String                             @db.Uuid
  status               TrainingSessionParticipationStatus @default(EXPECTED)
  sessionOutcome       String?
  trainerNotes         String?
  completionStatus     String?
  archivedAt           DateTime?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  session    TrainingSession    @relation(fields: [trainingSessionId], references: [id], onDelete: Restrict)
  enrollment TrainingEnrollment @relation(fields: [trainingEnrollmentId], references: [id], onDelete: Restrict)
  tasks      Task[]

  @@unique([trainingSessionId, trainingEnrollmentId])
  @@index([trainingEnrollmentId])
  @@index([status])
}

model ExternalTrainingParticipant {
  id              String                    @id @default(uuid()) @db.Uuid
  displayName     String
  email           String?
  normalizedEmail String?
  phone           String?
  organization    String?
  notes           String?
  status          ExternalParticipantStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  enrollments TrainingEnrollment[]

  @@unique([normalizedEmail])
  @@index([status])
}

model Document {
  id                   String             @id @default(uuid()) @db.Uuid
  title                String
  documentType         DocumentType
  currentVersionId     String?            @unique @db.Uuid
  visibility           DocumentVisibility @default(INTERNAL_ONLY)
  generated            Boolean            @default(false)
  outputFamily         OutputFamily?
  ownerUserId          String?            @db.Uuid
  createdByUserId      String?            @db.Uuid
  candidateId          String?            @db.Uuid
  clientId             String?            @db.Uuid
  recruitmentMissionId String?            @db.Uuid
  missionCandidateId   String?            @db.Uuid
  interviewId          String?            @db.Uuid
  trainingSessionId    String?            @db.Uuid
  trainingEnrollmentId String?            @db.Uuid
  messageId            String?            @db.Uuid
  status               DocumentStatus     @default(DRAFT)
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  owner              User?               @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("DocumentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  candidate          Candidate?          @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recruitmentMission RecruitmentMission? @relation(fields: [recruitmentMissionId], references: [id], onDelete: SetNull)
  missionCandidate   MissionCandidate?   @relation(fields: [missionCandidateId], references: [id], onDelete: SetNull)
  interview          Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  trainingSession    TrainingSession?    @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  message            Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  versions           DocumentVersion[]   @relation("DocumentVersions")
  currentVersion     DocumentVersion?    @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  tasks              Task[]
  notifications      Notification[]

  @@index([visibility])
  @@index([status])
  @@index([ownerUserId])
  @@index([candidateId])
  @@index([clientId])
  @@index([recruitmentMissionId])
  @@index([missionCandidateId])
  @@index([messageId])
}

model DocumentVersion {
  id               String                @id @default(uuid()) @db.Uuid
  documentId       String                @db.Uuid
  versionNumber    Int
  filename         String
  originalFilename String?
  storageKey       String                @unique
  mimeType         String
  sizeBytes        BigInt
  checksumSha256   String?
  outputFamily     OutputFamily?
  createdByUserId  String?               @db.Uuid
  source           DocumentVersionSource
  status           DocumentStatus        @default(ACTIVE)
  archivedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  document   Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor Document? @relation("CurrentDocumentVersion")
  createdBy  User?     @relation("DocumentVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([createdByUserId])
}

model Notification {
  id                   String             @id @default(uuid()) @db.Uuid
  idempotencyKey       String?            @unique
  recipientUserId      String             @db.Uuid
  actorUserId          String?            @db.Uuid
  type                 String
  title                String
  bodySummary          String?
  status               NotificationStatus @default(UNREAD)
  readAt               DateTime?
  taskId               String?            @db.Uuid
  documentId           String?            @db.Uuid
  interviewId          String?            @db.Uuid
  recruitmentMissionId String?            @db.Uuid
  missionCandidateId   String?            @db.Uuid
  trainingSessionId    String?            @db.Uuid
  trainingEnrollmentId String?            @db.Uuid
  archivedByUserId     String?            @db.Uuid
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  recipient          User                @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  actor              User?               @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  archivedBy         User?               @relation("NotificationArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  task               Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  document           Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  interview          Interview?          @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  recruitmentMission RecruitmentMission? @relation(fields: [recruitmentMissionId], references: [id], onDelete: SetNull)
  missionCandidate   MissionCandidate?   @relation(fields: [missionCandidateId], references: [id], onDelete: SetNull)
  trainingSession    TrainingSession?    @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  taskMentions       TaskMention[]       @relation("TaskMentionNotification")

  @@index([recipientUserId])
  @@index([actorUserId])
  @@index([status])
  @@index([readAt])
  @@index([taskId])
  @@index([documentId])
  @@index([archivedAt])
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  type              ConversationType
  title             String?
  relatedEntityType String?
  relatedEntityId   String?            @db.Uuid
  status            ConversationStatus @default(ACTIVE)
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
}

model ConversationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  conversationId String                 @db.Uuid
  userId         String                 @db.Uuid
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now())
  muted          Boolean                @default(false)
  active         Boolean                @default(true)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([active])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  authorUserId   String        @db.Uuid
  body           String
  status         MessageStatus @default(ACTIVE)
  editedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author       User         @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@index([conversationId])
  @@index([authorUserId])
  @@index([status])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  actorUserId     String?  @db.Uuid
  targetUserId    String?  @db.Uuid
  action          String
  entityType      String
  entityId        String?  @db.Uuid
  requestId       String?
  ipAddress       String?
  userAgent       String?
  metadataSummary String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  actor      User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}
