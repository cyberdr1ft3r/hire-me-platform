{
  "name": "@hire-me/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "dotenv -e ../../.env.example -- prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "prisma:generate": "dotenv -e ../../.env.example -- prisma generate",
    "prisma:validate": "dotenv -e ../../.env.example -- prisma validate",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hire-me/contracts": "workspace:*",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@prisma/client": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@hire-me/config": "workspace:*",
    "@nestjs/testing": "^11.1.5",
    "@types/node": "^24.1.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.13.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
