NODE_ENV=development

API_HOST=127.0.0.1
API_PORT=3000
API_CORS_ORIGIN=http://127.0.0.1:5173
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_ACCESS_TOKEN_SECRET=development_change_me_access_token_secret_32_chars_minimum
AUTH_REFRESH_TOKEN_PEPPER=development_change_me_refresh_token_pepper_32_chars_minimum
AUTH_COOKIE_SECURE=false

AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-synthetic-admin-password

VITE_API_BASE_URL=http://127.0.0.1:3000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=hire_me_dev
POSTGRES_USER=hire_me
POSTGRES_PASSWORD=hire_me_dev_password
DATABASE_URL=postgresql://hire_me:hire_me_dev_password@127.0.0.1:5432/hire_me_dev?schema=public
