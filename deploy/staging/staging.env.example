NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
API_CORS_ORIGIN=https://hire-me.dr1ft3r.dev
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_REFRESH_TOKEN_PEPPER=REPLACE_WITH_AN_INDEPENDENT_32_CHARACTER_SECRET
INVOICE_ISSUANCE_ENABLED=false
PRIVATE_UPLOAD_STORAGE_ROOT=/var/lib/hireme/private-documents
JSON_BODY_LIMIT=6mb
PUBLIC_APPLICATION_JSON_LIMIT=8mb
POSTGRES_DB=hire_me_staging
POSTGRES_USER=hire_me_staging
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://hire_me_staging:URL_ENCODED_DATABASE_PASSWORD@postgres:5432/hire_me_staging?schema=public
