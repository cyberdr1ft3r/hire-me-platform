hire-me.dr1ft3r.dev {
	encode zstd gzip

	@api path /health /auth /auth/* /v1 /v1/*
	handle @api {
		reverse_proxy hireme-api:3000
	}

	handle {
		reverse_proxy hireme-web:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
